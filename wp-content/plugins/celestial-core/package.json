{
	"name": "celestial-core",
	"version": "1.0.0",
	"description": "Block and editor asset tooling for the Celestial WordPress plugin.",
	"engines": {
		"node": "^24.0.0"
	},
	"engineStrict": true,
	"scripts": {
		"start:block": "wp-scripts start --source-path=blocks --output-path=build/blocks --blocks-manifest --experimental-modules",
		"start:editor": "wp-scripts start editor/index.js --output-path=build/editor",
		"start": "run-p start:*",
		"build:block": "wp-scripts build --source-path=blocks --output-path=build/blocks --blocks-manifest --experimental-modules",
		"build:editor": "wp-scripts build editor/index.js --output-path=build/editor",
		"build": "run-p build:*"
	},
	"devDependencies": {
		"@wordpress/scripts": "^32.0.0",
		"npm-run-all": "^4.1.5"
	}
}
